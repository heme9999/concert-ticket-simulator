---
import '@/styles/global.css';
import { FOOTER_LINKS, NAV_LINKS, SITE } from '@/config/site';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
  noindex?: boolean;
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  structuredData,
  noindex = false,
} = Astro.props;

const baseSite = Astro.site ?? new URL(SITE.baseUrl);
const normalizedPath = canonicalPath.endsWith('/') ? canonicalPath : `${canonicalPath}/`;
const canonicalUrl = new URL(normalizedPath, baseSite).toString();
const ogImageUrl = new URL('/og-image.png', baseSite).toString();
const schemas = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0e17" />
    <meta name="google-site-verification" content={SITE.googleSiteVerification} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <link rel="canonical" href={canonicalUrl} />
    )}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={SITE.brandName} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="StageDrill concert seat selection practice simulator arena map and HUD preview"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {schemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body class="min-h-screen bg-[#f8fafc] text-slate-900 antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-indigo-600 focus:px-4 focus:py-2 focus:text-sm focus:font-bold focus:text-white"
    >
      Skip to main content
    </a>

    <header class="sticky top-0 z-40 border-b border-slate-200/80 bg-white/85 backdrop-blur-md">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-4 py-3 sm:px-6">
        <a href="/" class="flex items-center gap-2 text-slate-950 no-underline">
          <span
            aria-hidden="true"
            class="inline-flex h-8 w-8 items-center justify-center rounded-xl bg-slate-950 text-xs font-black tracking-tight text-emerald-400"
          >
            SD
          </span>
          <span class="text-base font-extrabold tracking-tight">{SITE.brandName}</span>
          <span class="hidden rounded-full bg-slate-100 px-2 py-0.5 text-[11px] font-semibold text-slate-600 sm:inline-block">
            Practice Simulator
          </span>
        </a>

        <nav aria-label="Primary navigation" class="flex flex-wrap items-center gap-1 sm:gap-2">
          {NAV_LINKS.map((link) => {
            const active =
              Astro.url.pathname === link.href ||
              (link.href !== '/' && Astro.url.pathname.startsWith(link.href));
            return (
              <a
                href={link.href}
                aria-current={active ? 'page' : undefined}
                class={`rounded-lg px-2.5 py-1.5 text-xs font-semibold transition-colors sm:text-sm ${
                  active
                    ? 'bg-slate-950 text-white'
                    : 'text-slate-600 hover:bg-slate-100 hover:text-slate-950'
                }`}
              >
                {link.label}
              </a>
            );
          })}
        </nav>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="mt-16 border-t border-slate-200 bg-white">
      <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
        <div class="flex flex-col gap-6 md:flex-row md:items-start md:justify-between">
          <div class="max-w-xl space-y-2">
            <div class="text-sm font-extrabold text-slate-950">
              {SITE.brandName} · Concert Seat Selection Practice Simulator
            </div>
            <p class="text-xs leading-relaxed text-slate-600">
              {SITE.disclaimerShort} All scores reflect rule-based simulation feedback only and do not predict or improve real ticket queue placement or checkout outcomes.
            </p>
          </div>

          <nav aria-label="Footer navigation" class="flex flex-wrap gap-x-5 gap-y-2">
            {FOOTER_LINKS.map((link) => (
              <a
                href={link.href}
                class="text-xs font-semibold text-slate-600 hover:text-slate-950 hover:underline"
              >
                {link.label}
              </a>
            ))}
          </nav>
        </div>

        <p class="mt-6 border-t border-slate-100 pt-5 text-[11px] text-slate-500">
          Demo Arena: Starlight Civic Arena (Fictional Venue). No real ticketing accounts, payment cards, or live inventory are connected. Feedback &amp; bug reports:{' '}
          <a href={`mailto:${SITE.contactEmail}`} class="font-semibold text-slate-700 underline-offset-2 hover:underline">
            {SITE.contactEmail}
          </a>{' '}
          (cannot assist with real ticket orders).
        </p>
      </div>
    </footer>
  </body>
</html>
