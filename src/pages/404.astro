---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';

const title = `404 Page Not Found | ${SITE.brandName}`;
const description =
  'The requested page could not be found on StageDrill. Return to the concert seat selection simulator or browse our practice guides.';
---

<BaseLayout title={title} description={description} noindex={true}>
  <article class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-16">
    <div class="rounded-3xl border border-slate-200 bg-white p-6 shadow-sm sm:p-10">
      <p class="text-xs font-semibold uppercase tracking-widest text-sky-600">HTTP 404</p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-950 sm:text-4xl">
        404 &mdash; Page Not Found
      </h1>
      <p class="mt-4 text-sm leading-relaxed text-slate-700 sm:text-base">
        The URL you requested does not exist or has been moved. Use the links below to launch the interactive concert seat selection simulator or read the practice guides.
      </p>

      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href="/"
          class="pressable inline-flex items-center rounded-xl bg-slate-950 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-slate-800"
        >
          Back to Simulator Home
        </a>
        <a
          href="/practice/"
          class="pressable inline-flex items-center rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-900 transition hover:bg-slate-50"
        >
          Open Practice Arena
        </a>
      </div>

      <div class="mt-8 border-t border-slate-200 pt-6">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-900">
          Popular Pages &amp; Guides
        </h2>
        <ul class="mt-3 grid gap-2 text-sm text-sky-700 sm:grid-cols-2">
          <li>
            <a href="/guides/ticketmaster-training/" class="underline-offset-4 hover:underline">
              Ticketmaster Training Guide (What Simulators Can &amp; Cannot Do)
            </a>
          </li>
          <li>
            <a href="/guides/seat-selection-practice/" class="underline-offset-4 hover:underline">
              Seat Selection Strategy &amp; Adjacency Rules
            </a>
          </li>
          <li>
            <a href="/guides/scoring-explained/" class="underline-offset-4 hover:underline">
              How StageDrill Scoring Works (100-Point Guide)
            </a>
          </li>
          <li>
            <a href="/guides/concert-seat-selection-basics/" class="underline-offset-4 hover:underline">
              Concert Seat Selection Basics (Arena Tiers)
            </a>
          </li>
          <li>
            <a href="/about/" class="underline-offset-4 hover:underline">
              About {SITE.brandName}
            </a>
          </li>
          <li>
            <a href="/contact/" class="underline-offset-4 hover:underline">
              Contact ({SITE.contactEmail})
            </a>
          </li>
        </ul>
      </div>
    </div>
  </article>
</BaseLayout>
