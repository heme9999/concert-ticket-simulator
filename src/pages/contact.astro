---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/config/site';

const title = 'Contact StageDrill: Bug Reports & Simulator Feedback | StageDrill';
const description =
  'Contact StageDrill for simulator bug reports, reproducible seed feedback, guide corrections, or privacy questions. Independent practice tool, not live ticketing.';
---

<BaseLayout title={title} description={description} canonicalPath="/contact/">
  <article class="mx-auto max-w-4xl px-4 py-10 sm:px-6">
    <nav aria-label="Breadcrumb" class="mb-4 text-xs font-semibold text-slate-500">
      <a href="/" class="hover:text-slate-900">Home</a>
      <span class="mx-1.5">/</span>
      <span class="text-slate-900">Contact</span>
    </nav>

    <h1 class="display-h1 text-slate-950">Contact {SITE.brandName}</h1>
    <p class="mt-4 text-base leading-relaxed text-slate-700">
      Questions about how {SITE.brandName} simulates seat adjacency, reproducible seeds, accessibility, or privacy? Use the feedback builder form below or reach us directly by email.
    </p>

    <section class="mt-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
      <h2 id="contact-form-heading" class="section-h2 text-slate-950">
        Send Simulator Feedback or Bug Report
      </h2>
      <p class="mt-2 text-sm text-slate-600">
        Format your report with exact drill details (no account required). Submitting validates your message locally and prepares a formatted report you can open directly in your email client or copy to clipboard.
      </p>

      <form
        id="contact-form"
        aria-labelledby="contact-form-heading"
        action={`mailto:${SITE.contactEmail}`}
        method="GET"
        class="mt-6 space-y-6"
      >
        <fieldset class="space-y-2.5">
          <legend class="text-sm font-bold text-slate-950">
            Topic <span aria-hidden="true" class="text-rose-600">*</span>
          </legend>
          <div class="grid gap-2.5 sm:grid-cols-2">
            <label class="flex min-h-[48px] cursor-pointer items-center gap-2.5 rounded-xl border border-slate-300 bg-slate-50 px-3.5 py-2.5 text-sm font-semibold text-slate-900 hover:bg-slate-100">
              <input
                type="radio"
                id="cat-bug"
                name="category"
                value="Bug Report"
                required
                checked
                class="h-4 w-4 accent-indigo-600"
              />
              <span>Bug Report</span>
            </label>
            <label class="flex min-h-[48px] cursor-pointer items-center gap-2.5 rounded-xl border border-slate-300 bg-slate-50 px-3.5 py-2.5 text-sm font-semibold text-slate-900 hover:bg-slate-100">
              <input
                type="radio"
                id="cat-seed"
                name="category"
                value="Seed Scenario"
                class="h-4 w-4 accent-indigo-600"
              />
              <span>Seed Scenario</span>
            </label>
            <label class="flex min-h-[48px] cursor-pointer items-center gap-2.5 rounded-xl border border-slate-300 bg-slate-50 px-3.5 py-2.5 text-sm font-semibold text-slate-900 hover:bg-slate-100">
              <input
                type="radio"
                id="cat-guide"
                name="category"
                value="Guide Correction"
                class="h-4 w-4 accent-indigo-600"
              />
              <span>Guide Correction</span>
            </label>
            <label class="flex min-h-[48px] cursor-pointer items-center gap-2.5 rounded-xl border border-slate-300 bg-slate-50 px-3.5 py-2.5 text-sm font-semibold text-slate-900 hover:bg-slate-100">
              <input
                type="radio"
                id="cat-privacy"
                name="category"
                value="General / Privacy"
                class="h-4 w-4 accent-indigo-600"
              />
              <span>General / Privacy</span>
            </label>
          </div>
        </fieldset>

        <div class="flex flex-col items-start gap-1.5">
          <label for="contact-seed" class="text-sm font-bold text-slate-950">
            Seed / Drill Reference (optional)
          </label>
          <input
            id="contact-seed"
            name="seed"
            type="text"
            autocorrect="off"
            autocapitalize="none"
            spellcheck="false"
            enterkeyhint="next"
            aria-describedby="contact-seed-help"
            placeholder="e.g. arena-101 or spotlight-1341"
            class="field-control w-full rounded-xl border bg-white px-3.5 py-2.5 text-slate-950 placeholder:text-slate-400"
          />
          <span id="contact-seed-help" class="text-xs text-slate-600">
            Include Mode/Difficulty/Seed so we can replay the exact map layout.
          </span>
        </div>

        <div class="flex flex-col items-start gap-1.5">
          <label for="contact-email" class="text-sm font-bold text-slate-950">
            Your Reply Email (optional)
          </label>
          <input
            id="contact-email"
            name="email"
            type="email"
            autocomplete="email"
            autocorrect="off"
            autocapitalize="none"
            spellcheck="false"
            enterkeyhint="next"
            aria-describedby="contact-email-help"
            placeholder="you@example.com"
            class="field-control w-full rounded-xl border bg-white px-3.5 py-2.5 text-slate-950 placeholder:text-slate-400"
          />
          <span id="contact-email-help" class="text-xs text-slate-600">
            Leave blank if no reply is needed. Never enter real ticketing passwords or payment details.
          </span>
        </div>

        <div class="flex flex-col items-start gap-1.5">
          <label for="contact-message" class="text-sm font-bold text-slate-950">
            Message Details <span aria-hidden="true" class="text-rose-600">*</span>
          </label>
          <textarea
            id="contact-message"
            name="message"
            required
            minlength="10"
            rows="4"
            aria-describedby="contact-message-help"
            placeholder="Describe what happened, expected behavior, or guide correction (at least 10 characters)..."
            class="field-control w-full rounded-xl border bg-white px-3.5 py-2.5 text-slate-950 placeholder:text-slate-400"
          ></textarea>
          <span id="contact-message-help" class="text-xs text-slate-600">
            Minimum 10 characters required. Include browser/device width if reporting a layout issue.
          </span>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <button
            type="submit"
            id="contact-submit-btn"
            class="pressable min-h-[48px] rounded-xl bg-indigo-600 px-5 py-2.5 text-sm font-bold text-white transition hover:bg-indigo-500"
          >
            Prepare &amp; Send Feedback Report
          </button>
          <a
            href={`mailto:${SITE.contactEmail}`}
            class="inline-flex min-h-[48px] items-center rounded-xl border border-slate-300 bg-slate-50 px-4 py-2.5 font-mono text-xs font-semibold text-slate-900 hover:bg-slate-100 sm:text-sm"
          >
            Direct Email: {SITE.contactEmail}
          </a>
        </div>

        <div
          id="contact-status"
          role="status"
          aria-live="polite"
          hidden
          class="rounded-2xl border border-emerald-300 bg-emerald-50 p-4 text-sm text-emerald-950"
        >
          <p class="font-bold">Feedback report ready for <span class="font-mono">{SITE.contactEmail}</span></p>
          <pre
            id="contact-preview"
            class="mt-2 whitespace-pre-wrap rounded-xl border border-emerald-200 bg-white p-3 font-mono text-xs text-slate-800"
          ></pre>
          <div class="mt-3 flex flex-wrap gap-2.5">
            <a
              id="contact-mailto-link"
              href={`mailto:${SITE.contactEmail}`}
              class="inline-flex min-h-[40px] items-center rounded-lg bg-slate-950 px-3.5 py-2 text-xs font-bold text-white hover:bg-slate-800"
            >
              Open in Email App &rarr;
            </a>
            <button
              type="button"
              id="contact-copy-btn"
              class="inline-flex min-h-[40px] items-center rounded-lg border border-slate-300 bg-white px-3.5 py-2 text-xs font-bold text-slate-900 hover:bg-slate-100"
            >
              Copy Report Text
            </button>
          </div>
        </div>
      </form>
    </section>

    <section class="mt-8 space-y-3 text-sm leading-relaxed text-slate-700 sm:text-base">
      <h2 class="section-h2 text-slate-950">What We Can Help With</h2>
      <ul class="list-disc space-y-2 pl-5">
        <li>Reporting UI bugs, keyboard navigation gaps, or mobile SVG zoom/touch issues.</li>
        <li>Flagging unclear scoring feedback or suggesting new fictional drill rules.</li>
        <li>
          Correcting citations or clarifications in our{' '}
          <a href="/guides/ticketmaster-training/" class="font-semibold text-sky-700 underline-offset-4 hover:underline">training</a>,{' '}
          <a href="/guides/seat-selection-practice/" class="font-semibold text-sky-700 underline-offset-4 hover:underline">seat selection</a>, and{' '}
          <a href="/guides/scoring-explained/" class="font-semibold text-sky-700 underline-offset-4 hover:underline">scoring</a> guides.
        </li>
        <li>
          Questions about our{' '}
          <a href="/privacy/" class="font-semibold text-sky-700 underline-offset-4 hover:underline">localStorage-only privacy policy</a> or{' '}
          <a href="/terms/" class="font-semibold text-sky-700 underline-offset-4 hover:underline">simulation terms</a>.
        </li>
      </ul>
    </section>

    <section class="mt-8 rounded-2xl border border-amber-200 bg-amber-50/70 p-5 text-sm leading-relaxed text-amber-950">
      <h2 class="text-sm font-bold uppercase tracking-wider text-amber-900">
        No Access to Real Ticket Orders or Accounts
      </h2>
      <p class="mt-2">
        {SITE.brandName} is an independent practice simulator using fictional venue data (<strong>Starlight Civic Arena</strong>). We cannot look up, transfer, refund, or troubleshoot real Ticketmaster, Live Nation, AXS, or SeatGeek orders, queues, or accounts. For real ticket orders, contact your ticket seller directly.
      </p>
    </section>
  </article>

  <script is:inline define:vars={{ contactEmail: SITE.contactEmail }}>
    (function () {
      const form = document.getElementById('contact-form');
      const statusBox = document.getElementById('contact-status');
      const previewEl = document.getElementById('contact-preview');
      const mailtoLink = document.getElementById('contact-mailto-link');
      const copyBtn = document.getElementById('contact-copy-btn');
      const messageEl = document.getElementById('contact-message');
      if (!form || !statusBox || !previewEl || !mailtoLink || !copyBtn) return;

      if (messageEl) {
        messageEl.addEventListener('input', function () {
          messageEl.setCustomValidity('');
          messageEl.removeAttribute('aria-invalid');
        });
      }

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        if (!form.checkValidity()) {
          if (messageEl && !messageEl.validity.valid) {
            messageEl.setAttribute('aria-invalid', 'true');
            messageEl.setCustomValidity('Please enter at least 10 characters describing your feedback.');
          }
          form.reportValidity();
          const firstInvalid = form.querySelector(':invalid');
          if (firstInvalid && typeof firstInvalid.focus === 'function') {
            firstInvalid.focus();
          }
          return;
        }

        const data = new FormData(form);
        const category = String(data.get('category') || 'Feedback');
        const seedRef = String(data.get('seed') || '').trim() || 'Not specified';
        const replyEmail = String(data.get('email') || '').trim() || 'Anonymous';
        const message = String(data.get('message') || '').trim();

        const formattedBody = [
          'Category: ' + category,
          'Seed / Drill: ' + seedRef,
          'Reply Email: ' + replyEmail,
          '',
          message,
        ].join('\n');

        previewEl.textContent = formattedBody;
        const subject = '[StageDrill] ' + category + (seedRef !== 'Not specified' ? ' (' + seedRef + ')' : '');
        mailtoLink.setAttribute(
          'href',
          'mailto:' + contactEmail + '?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(formattedBody),
        );
        statusBox.hidden = false;
      });

      copyBtn.addEventListener('click', function () {
        const text = previewEl.textContent || '';
        if (!text) return;
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).then(function () {
            copyBtn.textContent = 'Copied Report!';
            setTimeout(function () {
              copyBtn.textContent = 'Copy Report Text';
            }, 1800);
          });
        }
      });
    })();
  </script>
</BaseLayout>
