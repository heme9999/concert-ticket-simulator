---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/config/site';

const title = 'Contact StageDrill - Bug Reports & Practice Simulator Feedback';
const description =
  'Contact StageDrill for simulator bug reports, reproducible seed feedback, guide corrections, or privacy questions. Independent practice tool, not live ticketing.';
---

<BaseLayout title={title} description={description} canonicalPath="/contact/">
  <article class="mx-auto max-w-4xl px-4 py-10 sm:px-6">
    <nav aria-label="Breadcrumb" class="mb-4 text-xs font-semibold text-slate-500">
      <a href="/" class="hover:text-slate-900">Home</a>
      <span class="mx-1.5">/</span>
      <span class="text-slate-900">Contact</span>
    </nav>

    <h1 class="display-h1 text-slate-950">Contact {SITE.brandName}</h1>
    <p class="mt-4 text-base leading-relaxed text-slate-700">
      Questions about how {SITE.brandName} simulates seat adjacency, reproducible seeds, accessibility, or privacy? Reach us directly by email.
    </p>

    <section class="mt-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
      <h2 class="section-h2 text-slate-950">Direct Email</h2>
      <p class="mt-3 text-sm leading-relaxed text-slate-700 sm:text-base">
        Send feedback, reproducible seed strings, browser bug reports, or privacy requests to:
      </p>
      <p class="mt-4">
        <a
          href={`mailto:${SITE.contactEmail}`}
          class="inline-flex items-center rounded-xl bg-slate-950 px-4 py-2.5 font-mono text-sm font-semibold text-white transition hover:bg-slate-800"
        >
          {SITE.contactEmail}
        </a>
      </p>
      <p class="mt-4 text-xs leading-relaxed text-slate-600">
        When reporting a drill bug or layout issue, include the exact <strong>Mode</strong>, <strong>Difficulty</strong>, <strong>Seed</strong> (for example <code>spotlight-1341</code>), and your browser/device viewport so we can replay the exact scenario.
      </p>
    </section>

    <section class="mt-8 space-y-3 text-sm leading-relaxed text-slate-700 sm:text-base">
      <h2 class="section-h2 text-slate-950">What We Can Help With</h2>
      <ul class="list-disc space-y-2 pl-5">
        <li>Reporting UI bugs, keyboard navigation gaps, or mobile SVG zoom/touch issues.</li>
        <li>Flagging unclear scoring feedback or suggesting new fictional drill rules.</li>
        <li>Correcting citations or clarifications in our <a href="/guides/ticketmaster-training/" class="font-semibold text-sky-700 underline-offset-4 hover:underline">training</a> and <a href="/guides/seat-selection-practice/" class="font-semibold text-sky-700 underline-offset-4 hover:underline">seat selection</a> guides.</li>
        <li>Questions about our <a href="/privacy/" class="font-semibold text-sky-700 underline-offset-4 hover:underline">localStorage-only privacy policy</a> or <a href="/terms/" class="font-semibold text-sky-700 underline-offset-4 hover:underline">simulation terms</a>.</li>
      </ul>
    </section>

    <section class="mt-8 rounded-2xl border border-amber-200 bg-amber-50/70 p-5 text-sm leading-relaxed text-amber-950">
      <h2 class="text-sm font-bold uppercase tracking-wider text-amber-900">
        No Access to Real Ticket Orders or Accounts
      </h2>
      <p class="mt-2">
        {SITE.brandName} is an independent practice simulator using fictional venue data (<strong>Starlight Civic Arena</strong>). We cannot look up, transfer, refund, or troubleshoot real Ticketmaster, Live Nation, AXS, or SeatGeek orders, queues, or accounts. For real ticket orders, contact your ticket seller directly.
      </p>
    </section>
  </article>
</BaseLayout>
