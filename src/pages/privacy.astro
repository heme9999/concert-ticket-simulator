---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/config/site';

const title = 'Privacy Policy & Local Storage | StageDrill';
const description =
  'Read how StageDrill handles data locally in your browser using localStorage without user accounts, payment collection, or server-side profiles.';
---

<BaseLayout title={title} description={description} canonicalPath="/privacy/">
  <article class="mx-auto max-w-4xl px-4 py-10 sm:px-6">
    <nav aria-label="Breadcrumb" class="mb-4 text-xs font-semibold text-slate-500">
      <a href="/" class="hover:text-slate-900">Home</a>
      <span class="mx-1.5">/</span>
      <span class="text-slate-900">Privacy</span>
    </nav>

    <h1 class="display-h1 text-slate-950">Privacy Policy</h1>
    <p class="mt-4 text-base leading-relaxed text-slate-700">
      {SITE.brandName} runs client-side in your web browser without user accounts, login forms, or server-side databases. We do not ask for or collect names, email addresses, ticketing credentials, or payment card information.
    </p>

    <section class="mt-8 space-y-3 text-sm leading-relaxed text-slate-700 sm:text-base">
      <h2 class="section-h2 text-slate-950">Browser localStorage Usage</h2>
      <p>
        To keep your practice preferences and recent practice scores across page reloads, the simulator stores JSON data strictly on your device using these keys (and gracefully falls back to temporary in-memory storage if your browser blocks storage):
      </p>
      <ul class="list-disc space-y-2 pl-5">
        <li>
          <code>stagedrill_settings_v1</code>: Stores your preferred mode, difficulty, and reduced-motion preference.
        </li>
        <li>
          <code>stagedrill_history_v1</code>: Stores up to your 10 most recent local practice scores, seeds, and completion times.
        </li>
        <li>
          <code>stagedrill_active_round_v1</code>: Temporarily stores an in-progress drill so you can resume if the page refreshes, and is cleared when the round finishes.
        </li>
      </ul>
    </section>

    <section class="mt-8 space-y-3 text-sm leading-relaxed text-slate-700 sm:text-base">
      <h2 class="section-h2 text-slate-950">Clearing Your Data</h2>
      <p>
        You can delete all locally saved simulator data at any time by clearing site data / localStorage in your browser settings.
      </p>
    </section>
  </article>
</BaseLayout>
