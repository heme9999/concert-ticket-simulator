---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/config/site';

const title = 'Terms of Use & Simulation Disclaimer | StageDrill';
const description =
  'Terms of use for StageDrill: an educational concert seat selection simulator with virtual demo pricing and no connection to real ticket sales.';
---

<BaseLayout title={title} description={description} canonicalPath="/terms/">
  <article class="mx-auto max-w-4xl px-4 py-10 sm:px-6">
    <nav aria-label="Breadcrumb" class="mb-4 text-xs font-semibold text-slate-500">
      <a href="/" class="hover:text-slate-900">Home</a>
      <span class="mx-1.5">/</span>
      <span class="text-slate-900">Terms</span>
    </nav>

    <h1 class="display-h1 text-slate-950">Terms of Use &amp; Simulation Disclaimer</h1>
    <p class="mt-4 text-base leading-relaxed text-slate-700">
      By using {SITE.brandName}, you acknowledge that all seating layouts, ticket prices, demand waves, waiting transitions, and practice scores are fictional educational simulations.
    </p>

    <section class="mt-8 space-y-3 text-sm leading-relaxed text-slate-700 sm:text-base">
      <h2 class="section-h2 text-slate-950">1. Educational Practice Only</h2>
      <p>
        {SITE.brandName} does not sell tickets, facilitate ticket transfers, connect to live third-party APIs, or simulate real anti-bot systems. No score on this site represents a real-world ticket purchase probability or queue guarantee.
      </p>
    </section>

    <section class="mt-8 space-y-3 text-sm leading-relaxed text-slate-700 sm:text-base">
      <h2 class="section-h2 text-slate-950">2. Independent &amp; Non-Affiliated</h2>
      <p>
        References to official ticketing workflows in our guides are strictly informational. All trademarks belong to their respective owners, and no sponsorship or partnership is implied.
      </p>
    </section>

    <section class="mt-8 space-y-3 text-sm leading-relaxed text-slate-700 sm:text-base">
      <h2 class="section-h2 text-slate-950">3. Availability &amp; Contact</h2>
      <p>
        This free browser tool is provided &ldquo;as is&rdquo; without warranties of uninterrupted availability or fitness for any commercial purpose. Questions about these terms or simulation rules may be sent to{' '}
        <a href={`mailto:${SITE.contactEmail}`} class="font-semibold text-sky-700 underline-offset-4 hover:underline">
          {SITE.contactEmail}
        </a>{' '}
        via our <a href="/contact/" class="font-semibold text-sky-700 underline-offset-4 hover:underline">Contact page</a> (cannot assist with real ticketing accounts or orders).
      </p>
    </section>
  </article>
</BaseLayout>
